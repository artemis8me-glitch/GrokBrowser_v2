{
  "name": "empire-terminal-2",
  "private": true,
  "version": "0.0.0",
  "main": "electron.js",
  "type": "module",
  "description": "Empire Terminal with Grok AI",
  "author": {
    "name": "DevOps",
    "email": "devops@empire.com"
  },
  "homepage": "https://empire.com",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:server": "USE_VITE_DEV_SERVER=1 npm run electron:dev",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npx concurrently \"npm run dev:web\" \"node scripts/run-electron-dev.mjs\"",
    "electron:local": "npx concurrently \"npm run build:watch\" \"node scripts/run-electron-local.mjs\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.empire.terminal",
    "productName": "Empire Terminal",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^1.33.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^7.3.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@tanstack/react-query": "^5.90.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lightweight-charts": "^5.0.9",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.1.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.11.0",
    "react-secure-storage": "^1.3.2",
    "react-tabs": "^6.1.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "npm:rolldown-vite@7.2.5",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
